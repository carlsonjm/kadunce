+    {
+        // A native move can finish before the touch is released, e.g. when an
+        // effect takes over. Never reuse that contact for another move lifetime.
+        if (m_touchWindow != window || m_touchMoveCount != window->interactiveMoveResizeCount()) {
+            m_touchWindow = window;
+            m_touchMoveCount = window->interactiveMoveResizeCount();
+            m_set = false;
