#: control/src/main.cpp
msgid "Cards"
msgstr "Tarjetas"

#: control/src/main.cpp
msgid "Cards on"
msgstr "Tarjetas activadas"

#: control/src/main.cpp
msgid "Checking KWin compatibility…"
msgstr "Comprobando la compatibilidad con KWin…"

#: control/src/main.cpp
msgid "Repair for current KWin…"
msgstr "Reparar para el KWin actual…"

#: control/src/main.cpp
msgid "Repair cards"
msgstr "Reparar tarjetas"

#: control/src/main.cpp
msgid "Rebuilt and installed for the current KWin. Your enabled/disabled choice was preserved. No session restart was performed. If KWin still rejects it, save your work and log out and back in."
msgstr "Reconstruido e instalado para el KWin actual. Se conservó tu elección de activado o desactivado. No se reinició la sesión. Si KWin lo sigue rechazando, guarda tu trabajo y cierra la sesión y vuelve a entrar."

#: control/src/main.cpp
msgid "Repair did not complete. No effect toggle or desktop restart was requested. See details for the failing step."
msgstr "La reparación no terminó. No se pidió cambiar el efecto ni reiniciar el escritorio. Consulta los detalles para ver el paso que falló."

#: control/src/main.cpp
msgid "Repair could not start"
msgstr "No se pudo iniciar la reparación"

#: control/src/main.cpp
msgid "Monitors use my zones (Meta+T)"
msgstr "Los monitores usan mis zonas (Meta+T)"

#: control/src/main.cpp
msgid "Settings…"
msgstr "Configuración…"

#: control/src/main.cpp
msgid "Repair cards?"
msgstr "¿Reparar tarjetas?"

#: control/src/main.cpp
msgid "Rebuild the source saved during installation for your current KWin? No downloads or development-folder changes are used. Checks run before an administrator prompt installs the plugin. Your workspace switch stays available; nothing will restart automatically."
msgstr "¿Reconstruir para tu KWin actual el código fuente guardado durante la instalación? No se descarga nada ni se cambia ninguna carpeta de desarrollo. Se hacen comprobaciones antes de la petición de administrador que instala el complemento. El interruptor del espacio de trabajo sigue disponible; nada se reinicia automáticamente."

#: control/src/main.cpp
msgid "Cards settings"
msgstr "Configuración de tarjetas"

#: control/src/main.cpp
msgctxt "@item:valuesuffix the gutter, in pixels"
msgid " px"
msgstr " px"

#: control/src/main.cpp
msgid "Active card gutter"
msgstr "Margen de la tarjeta activa"

#: control/src/main.cpp
msgid ""
"Default: 10 px. Applies at once, and Bento's panes stand as far apart.\n"
"4–48 px. The gutter preserves room for edge swipes."
msgstr ""
"Predeterminado: 10 px. Se aplica al momento, y los paneles de Bento quedan igual de separados.\n"
"4–48 px. El margen deja espacio para deslizar desde el borde."

#: control/src/main.cpp
msgid "KWin %1 → %2: rebuild needed"
msgstr "KWin %1 → %2: hace falta reconstruir"

#: control/src/main.cpp
msgid "KWin compatibility could not be determined"
msgstr "No se pudo determinar la compatibilidad con KWin"

#: control/src/main.cpp
msgid "Built for installed KWin %1"
msgstr "Construido para el KWin %1 instalado"

#: control/src/main.cpp
msgid "Repair in progress…"
msgstr "Reparación en curso…"

#: control/src/main.cpp
msgid "Off"
msgstr "Desactivado"

#: control/src/main.cpp
msgid "On"
msgstr "Activado"

#: control/src/main.cpp
msgid "Changing cards…"
msgstr "Cambiando las tarjetas…"

#: control/src/main.cpp
msgid "Cards need a rebuild"
msgstr "Hay que reconstruir las tarjetas"

#: control/src/main.cpp
msgid "KWin was updated. Choose ‘Repair for current KWin’ from this tray menu. If you have not restarted since the system update, finish it with a normal logout/login first."
msgstr "KWin se actualizó. Elige «Reparar para el KWin actual» en este menú de la bandeja. Si no has reiniciado desde la actualización del sistema, termínala primero cerrando la sesión y volviendo a entrar."

#: control/src/main.cpp
msgid "Cards stayed off"
msgstr "Las tarjetas siguen desactivadas"

#: control/src/main.cpp
msgid "KWin did not accept the workspace effect. The previous disabled state was preserved."
msgstr "KWin no aceptó el efecto del espacio de trabajo. Se conservó el estado desactivado anterior."

#: control/src/main.cpp
msgid "Spread and Bento are ready."
msgstr "Abanico y Bento están listos."

#: control/src/main.cpp
msgid "Cards stayed on"
msgstr "Las tarjetas siguen activadas"

#: control/src/main.cpp
msgid "KWin could not confirm a safe release, so the enabled state was restored."
msgstr "KWin no pudo confirmar una liberación segura, así que se restauró el estado activado."

#: control/src/main.cpp
msgid "Cards off"
msgstr "Tarjetas desactivadas"

#: control/src/main.cpp
msgid "Managed windows were safely released."
msgstr "Las ventanas gestionadas se liberaron de forma segura."
