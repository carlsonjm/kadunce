[Unit]
Description=Kadunce workspace control
PartOf=graphical-session.target
After=graphical-session.target plasma-workspace.target
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
Type=simple
ExecStart=%h/.local/bin/kadunce-control
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
